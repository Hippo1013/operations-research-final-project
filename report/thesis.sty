% \newtheorem{problem}{Question.}[section]
\newcounter{problemname}
\newenvironment{problem}{\begin{shaded}\stepcounter{problemname}\par\noindent\textbf{Question.\arabic{problemname}. }}{\end{shaded}\par}
\newenvironment{solution}{\par\noindent\textbf{解答.}}{\par}

%-------------------------目录设置------------------------------%
\renewcommand{\contentsname}{目录}

\newcommand{\maketoc}{%  
    \newpage  
    \tableofcontents  
    \thispagestyle{empty} % Removes the page numbering.  
    \newpage  
    \pagenumbering{arabic} % 重新开始标号，阿拉伯数字形式  
}  

%-------------------------页眉页脚------------------------------%
\newcommand{\reporttitle}[1]{\gdef\@reporttitle{#1}}
\newcommand{\course}[1]{\gdef\@course{#1}}
\newcommand{\studentname}[1]{\gdef\@studentname{#1}}
\newcommand{\studentnamelines}[2]{%
    \gdef\@studentnamelineone{#1}%
    \gdef\@studentnamelinetwo{#2}%
}
\newcommand{\studentid}[1]{\gdef\@studentid{#1}}
\newcommand{\college}[1]{\gdef\@college{#1}}
\newcommand{\major}[1]{\gdef\@major{#1}}
\newcommand{\instructor}[1]{\gdef\@instructor{#1}}
\newcommand{\experimentdate}[1]{\gdef\@experimentdate{#1}}
\newcommand{\grade}[1]{\gdef\@grade{#1}}

\reporttitle{}
\course{}
