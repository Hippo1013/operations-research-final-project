\newcommand{\classname}[1]{\course{#1}}
\newcommand{\printclassname}{\@course}
  
\newcommand{\makepagestyle}[2]{%  
    \pagestyle{fancy}
    \fancyhf{}
    \chead{\small\@reporttitle}
    \cfoot{\thepage}
}  

\fancypagestyle{plain}{%
    \fancyhf{}
    \chead{\small\@reporttitle}
    \cfoot{\thepage}
    \renewcommand{\headrulewidth}{0.4pt}
    \renewcommand{\footrulewidth}{0pt}
}
  
% 正文页显示页眉分隔线，正文首页同样显示页眉
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\theenumi}{(\arabic{enumi})}  

%-------------------------封面设置------------------------------%
\newcommand{\reportline}[2]{\underline{\makebox[#1][c]{#2}}}

\newcommand{\maketitlepage}{% 封面
    \begin{titlepage}
        \thispagestyle{empty}
        \centering
        \vspace*{-0.3cm}
        \vbox to 0.94\textheight{%
            \centering
            \includegraphics[width=0.58\linewidth]{figures/char.png}\par
            \vspace{0.45cm}
            \includegraphics[width=0.36\linewidth]{figures/logo.png}\par

            % \vfill
            \vspace{0.1cm}
            {\fontsize{22pt}{30pt}\selectfont\bfseries
            面向月球基地建设的\\
            材料运输运筹学优化方案\par}
            
            \vspace{0.5cm}
            % \vfill
            {\large
            \renewcommand{\arraystretch}{1.85}
            \begin{tabular}{@{}rl@{}}
                课程名称 & \reportline{230pt}{\@course} \\
                指导老师 & \reportline{230pt}{\@instructor} \\
                姓名 & \reportline{230pt}{\@studentnamelineone} \\
                     & \reportline{230pt}{\@studentnamelinetwo} \\
            \end{tabular}\par}
            \vspace{0.6cm}
        }
    \end{titlepage}
}

